{
  "name": "@nymrel/agent",
  "version": "0.4.0",
  "description": "Explainable multi-model routing with a stateless API, local CLI, MCP server, and low-custody execution harness.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://nymrel-agent.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nymrel/nymrel-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Nymrel/nymrel-agent/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "mcp",
    "model-router",
    "routing"
  ],
  "files": [
    "dist/src",
    "examples",
    "docs/JOB_MODE.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "nymrel-agent": "dist/src/bin/nymrel-agent.js",
    "nymrel-agent-mcp": "dist/src/bin/nymrel-agent-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./dist/src/mcp.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "npm run clean --silent && tsc -p tsconfig.package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.package.json --noEmit",
    "test": "npm run compile --silent && node --test \"dist/test/*.test.js\"",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:candidate": "npm run compile --silent && node scripts/verify-candidate.mjs",
    "verify:packed-install": "npm run compile --silent && node scripts/verify-packed-install.mjs",
    "verify:candidate-packed-install": "npm run compile --silent && node scripts/verify-packed-install.mjs --candidate",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run verify:release && npm run verify:candidate && npm run verify:candidate-packed-install && npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "smoke": "npm run compile --silent && node dist/src/bin/nymrel-agent.js route --file examples/route-request.json",
    "mcp": "node dist/src/bin/nymrel-agent-mcp.js",
    "prepack": "npm run compile --silent && npm run verify:candidate"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@vercel/firewall": "1.2.5",
    "hono": "4.13.7",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
